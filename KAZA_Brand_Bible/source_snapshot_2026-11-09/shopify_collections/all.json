1841,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0807\/0447\/1281\/files\/ChatGPTImageSep25_2026_04_47_33PM-4.png?v=1790335078","width":1254,"height":1254},{"id":50882895249649,"created_at":"2026-09-25T16:47:56+05:30","position":3,"updated_at":"2026-09-25T16:47:57+05:30","product_id":10303179161841,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0807\/0447\/1281\/files\/ChatGPTImageSep25_2026_04_47_32PM-3.png?v=1790335077","width":1254,"height":1254},{"id":50882895282417,"created_at":"2026-09-25T16:47:56+05:30","position":4,"updated_at":"2026-09-25T16:47:57+05:30","product_id":10303179161841,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0807\/0447\/1281\/files\/ChatGPTImageSep25_2026_04_47_30PM-2.png?v=1790335077","width":1254,"height":1254},{"id":50882895315185,"created_at":"2026-09-25T16:47:56+05:30","position":5,"updated_at":"2026-09-25T16:47:57+05:30","product_id":10303179161841,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0807\/0447\/1281\/files\/ChatGPTImageSep25_2026_04_47_29PM-1.png?v=1790335077","width":1254,"height":1254}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9670129942769,"title":"Kaza Beauty Clear code serum","handle":"kaza-beauty-lip-gloss-1","body_html":"\u003cp data-start=\"0\" data-end=\"313\" class=\"PDq2pG_selectionAnchorContainer\"\u003e\u003cstrong data-start=\"0\" data-end=\"32\"\u003eKaza Beauty Clear Code Serum\u003c\/strong\u003e is a lightweight, fast-absorbing niacinamide serum designed to help refine the look of pores, control excess oil and improve uneven-looking skin. Powered by \u003cstrong data-start=\"190\" data-end=\"209\"\u003e10% niacinamide\u003c\/strong\u003e, it supports a smoother, clearer and more balanced complexion without leaving the skin sticky or heavy.\u003cspan aria-hidden=\"true\" class=\"PDq2pG_selectionAnchor\"\u003e\u003c\/span\u003e\u003c\/p\u003e\n\u003cp data-start=\"315\" data-end=\"516\"\u003eWith regular use, the serum helps reduce dullness, improve skin texture and maintain a fresh, shine-controlled finish. Its gentle everyday formula layers easily under moisturiser, sunscreen and makeup.\u003c\/p\u003e\n\u003cp data-start=\"518\" data-end=\"677\"\u003e\u003cstrong data-start=\"518\" data-end=\"535\"\u003eKey benefits:\u003c\/strong\u003e\u003cbr data-start=\"535\" data-end=\"538\"\u003eMinimises the appearance of pores • Controls excess oil • Brightens dull-looking skin • Smooths uneven texture • Lightweight and non-greasy\u003c\/p\u003e\n\u003cp data-start=\"679\" data-end=\"812\" data-is-last-node=\"\" data-is-only-node=\"\"\u003e\u003cstrong data-start=\"679\" data-end=\"694\"\u003eHow to use:\u003c\/strong\u003e Apply 2–3 drops to clean, dry skin before moisturiser. Use once or twice daily, followed by sunscreen during the day.\u003c\/p\u003e","published_at":"2026-07-15T02:58:45+05:30","created_at":"2026-07-15T02:58:44+05:30","updated_at":"2026-11-09T17:06:08+05:30","vendor":"My Store 4","product_type":"","tags":[],"variants":[{"id":48409341493489,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":null,"requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"1299.00","grams":0,"compare_at_price":null,"position":1,"product_id":9670129942769,"created_at":"2026-07-15T02:58:44+05:30","updated_at":"2026-11-09T17:06:08+05:30"}],"images":[{"id":50163504677105,"created_at":"2026-07-15T03:08:17+05:30","position":1,"updated_at":"2026-07-15T03:08:19+05:30","product_id":9670129942769,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0807\/0447\/1281\/files\/ChatGPT_Image_Jul_15_2026_03_07_49_AM.png?v=1784065099","width":1254,"height":1254}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9671641006321,"title":"Kaza beauty Cloud Cream","handle":"kaza-beauty-cloud-cream","body_html":"\u003cp\u003eKaza Beauty Cloud Cream Moisturiser is a lightweight, deeply hydrating face cream designed to nourish dry, dull and tired-looking skin. Powered by a moisture-rich hydration complex, it helps strengthen the skin barrier, improve softness and lock in long-lasting hydration without feeling heavy or greasy.\u003c\/p\u003e\n\u003cp\u003eIts smooth, cloud-like texture absorbs effortlessly, leaving skin plump, comfortable and naturally radiant. Suitable for all skin types and ideal for everyday use.\u003cbr\u003e\u003c\/p\u003e","published_at":"2026-07-15T20:45:48+05:30","created_at":"2026-07-15T20:45:46+05:30","updated_at":"2026-11-09T17:06:08+05:30","vendor":"Kaza Beauty","product_type":"","tags":[],"variants":[{"id":48414127685873,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":null,"requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"1199.00","grams":100,"compare_at_price":null,"position":1,"product_id":9671641006321,"created_at":"2026-07-15T20:45:47+05:30","updated_at":"2026-11-09T17:06:08+05:30"}],"images":[{"id":50171958198513,"created_at":"2026-07-15T20:45:25+05:30","position":1,"updated_at":"2026-07-15T20:45:27+05:30","product_id":9671641006321,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0807\/0447\/1281\/files\/ChatGPTImageJul15_2026_08_43_39PM.png?v=1784128527","width":1254,"height":1254}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9670009258225,"title":"Kaza Beauty Glow C Serum","handle":"kaza-beauty-glow-c-serum","body_html":"Kaza Beauty Glow C Serum is a lightweight, fast-absorbing facial serum formulated to brighten and revitalize your complexion. Enriched with vitamin C and potent antioxidants, this serum helps reduce the appearance of dark spots, uneven skin tone, and fine lines while promoting a radiant, youthful glow. Perfect for all skin types, it absorbs quickly without leaving a greasy residue. Apply a few drops to clean skin each morning and evening for best results. Unlock your skin's natu